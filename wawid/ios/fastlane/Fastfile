# Publication TestFlight de WawID e-Visa (signature automatique via une clé API App Store Connect).
default_platform(:ios)

platform :ios do
  desc "Compile, signe et envoie une version sur TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    key_path = File.expand_path("AuthKey.p8", Dir.pwd)
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )
    increment_build_number(build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1, xcodeproj: "WawIDVisa.xcodeproj")
    build_app(
      project: "WawIDVisa.xcodeproj",
      scheme: "WawIDVisa",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "WawID e-Visa : scan MRZ, lecture NFC de la puce du passeport, dépôt et suivi de la demande."
    )
  end
end
